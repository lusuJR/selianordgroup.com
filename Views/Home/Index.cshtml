@{
    ViewData["Title"] = "Welcome to Selianord Group";
}

<!-- =========================
     HERO SECTION
========================= -->
<section class="hero d-flex align-items-center justify-content-center text-center text-white">
    <div class="container-fluid px-3">
        <div class="mx-auto" style="max-width: 900px;">
            <h1 class="display-4 fw-bold mb-4 animate__animated animate__fadeInDown">
                Empowering People Through 
                <span class="text-warning">Innovation</span> & Learning
            </h1>
            <p class="lead mb-5 animate__animated animate__fadeInUp text-light">
                Selianord Group delivers world-class corporate training, 
                software development, and digital transformation solutions 
                that empower individuals and organizations to thrive in the modern digital era.
            </p>
            <a href="#services" 
               class="btn btn-lg btn-outline-light px-5 py-3 fw-semibold shadow-lg animate__animated animate__fadeInUp rounded-pill">
                Learn More
            </a>
        </div>
    </div>
</section>

<!-- =========================
     ABOUT US SECTION
========================= -->
<section id="about" class="about-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <!-- Image -->
            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="~/images/about-team.jpg" 
                     alt="Selianord Group Team" 
                     class="img-fluid rounded shadow-lg" />
            </div>
            <!-- Text -->
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3 text-primary">About Selianord Group</h2>
                <p class="lead mb-3">
                    At <strong>Selianord Group</strong>, we empower individuals and organizations 
                    through world-class <span class="text-primary fw-semibold">training</span>, 
                    innovative <span class="text-primary fw-semibold">software solutions</span>, 
                    and transformative <span class="text-primary fw-semibold">digital learning experiences</span>.
                </p>
                <p>
                    Our goal is to bridge the gap between people and technology — helping professionals 
                    develop skills that drive innovation, business performance, and sustainable growth.
                </p>
                <a href="/Home/Contact" class="btn btn-primary-custom mt-3 px-4 py-2 fw-semibold rounded-pill">
                    Learn More
                </a>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     SERVICES SECTION
========================= -->
<section id="services" class="py-5 bg-light text-center">
    <div class="container">
        <p class="text-muted mb-1">We partner with organizations to unlock human potential</p>
        <h2 class="fw-bold mb-5">Our Core Services</h2>

        <div class="row g-4">
            <!-- Corporate Training -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100 service-card">
                    <div class="card-body">
                        <i class="bi bi-briefcase-fill icon-service"></i>
                        <h5 class="fw-bold mt-3">Corporate Training</h5>
                        <p>Tailored programs to enhance professional skills and business performance.</p>
                    </div>
                </div>
            </div>

            <!-- Software Development -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100 service-card">
                    <div class="card-body">
                        <i class="bi bi-laptop-fill icon-service"></i>
                        <h5 class="fw-bold mt-3">Software Development</h5>
                        <p>Custom software and web apps built using modern Microsoft technologies.</p>
                    </div>
                </div>
            </div>

            <!-- Learning Material Development -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100 service-card">
                    <div class="card-body">
                        <i class="bi bi-book-half icon-service"></i>
                        <h5 class="fw-bold mt-3">Learning Material Development</h5>
                        <p>Engaging learning resources designed for academic and professional training.</p>
                    </div>
                </div>
            </div>

            <!-- Site-Based Learning -->
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100 service-card">
                    <div class="card-body">
                        <i class="bi bi-people-fill icon-service"></i>
                        <h5 class="fw-bold mt-3">Site-Based Learning</h5>
                        <p>On-site, hands-on learning experiences focused on practical skill application.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================
     CTA SECTION
========================= -->
<section class="cta-section text-center text-white">
    <div class="container">
        <h2 class="fw-bold mb-3">Partner with Selianord Group Today</h2>
        <p class="lead mb-4">
            Empowering businesses through technology, education, and innovation — 
            we’re committed to your success in the digital era.
        </p>
        <a href="/Home/Contact" class="btn btn-light btn-lg px-5 fw-semibold shadow rounded-pill">
            Get in Touch
        </a>
    </div>
</section>

<!-- =========================
     WAVE DIVIDER
========================= -->
<div class="wave-divider">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" role="presentation" aria-hidden="true">
        <path fill="#f8f9fa" fill-opacity="1"
              d="M0,192L80,186.7C160,181,320,171,480,181.3C640,192,800,224,960,224C1120,224,1280,192,1360,176L1440,160V320H0Z"></path>
    </svg>
</div>
